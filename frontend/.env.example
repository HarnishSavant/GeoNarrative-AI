# GeoNarrative AI — Environment Variables
# Copy this file to .env.local and add your actual keys

# Mapbox Access Token (required for interactive map)
# Get yours at: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Gemini API Key (required for AI chat)
# Get yours at: https://makersuite.google.com/app/apikey
NEXT_PUBLIC_GEMINI_KEY=

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
