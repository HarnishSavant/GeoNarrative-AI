# GeoNarrative AI Backend Environment
# SECURITY: Never commit real values to version control.
# Copy this to .env and fill in your actual keys.

# === CRITICAL SECURITY ===
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_HEX_VALUE
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME_WITH_REAL_SECRET

# === API Keys ===
GEMINI_API_KEY=
MAPBOX_TOKEN=
WEATHER_API_KEY=

# === Database ===
DATABASE_URL=postgresql://postgres:root@localhost:5432/geonarrative

# === SMTP Email ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@geonarrative.ai

# === Frontend ===
FRONTEND_URL=http://localhost:3000

# === App ===
DEBUG=false
